<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== 'undefined' ? title : 'GeM Bid Compliance Platform' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,700;1,9..40,400&family=Libre+Baskerville:wght@400;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/static/css/style.css" />
</head>
<body>
  <div class="top-strip"></div>
  <nav class="navbar navbar-expand-lg site-nav" id="mainNav">
    <div class="container">
      <a class="navbar-brand" href="/">
        <span class="brand-mark">GeM</span>
        <span class="brand-text">Compliance Verify</span>
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navMain">
        <ul class="navbar-nav ms-auto gap-lg-2">
          <% if (user && user.role === 'admin') { %>
            <li class="nav-item"><a class="nav-link" href="/admin/dashboard">Admin Dashboard</a></li>
            <li class="nav-item"><a class="nav-link" href="/admin/api-status">API Status</a></li>
            <li class="nav-item"><a class="nav-link" href="/tenders/import-gem">Tenders</a></li>
            <li class="nav-item"><a class="nav-link" href="/admin/officers">Staff</a></li>
            <li class="nav-item"><a class="nav-link" href="/admin/assignments">Assignments</a></li>
          <% } else if (user && user.role === 'officer') { %>
            <li class="nav-item"><a class="nav-link" href="/dashboard">Review Queue</a></li>
          <% } else if (user && user.role === 'bidder') { %>
            <li class="nav-item"><a class="nav-link" href="/bidder/dashboard">My Dashboard</a></li>
            <li class="nav-item"><a class="nav-link" href="/upload">Submit Document</a></li>
          <% } %>

          <% if (user) { %>
            <li class="nav-item d-flex align-items-center me-2">
              <span class="badge bg-secondary text-uppercase"><%= user.role %></span>
              <span class="small text-light ms-2"><%= user.name %></span>
            </li>
            <li class="nav-item ms-lg-2"><a class="btn btn-outline-danger btn-sm nav-logout" href="/logout">Log out</a></li>
          <% } else { %>
            <li class="nav-item"><a class="nav-link" href="/">Sign in</a></li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>

  <% if (messages && messages.length > 0) { %>
    <div class="container mt-3" id="alertsContainer">
      <% messages.forEach(function(msg) { %>
        <div class="alert alert-<%= msg.type || 'info' %> alert-dismissible fade show" role="alert">
          <%= msg.text %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% }); %>
    </div>
  <% } %>

  <main>
